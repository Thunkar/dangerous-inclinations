{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"],
    "paths": {
      "@dangerous-inclinations/engine": ["../engine/src/index.ts"]
    }
  },
  "include": [
    "vite.config.ts",
    "spec.ts",
    "colours.ts",
    "lib/**/*.ts",
    "pieces/**/*.ts",
    "scripts/**/*.ts",
    "coupons/**/*.part.js",
    "parts/**/*.part.js"
  ]
}
