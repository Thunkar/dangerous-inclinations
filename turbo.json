{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "tsconfig.json", "package.json"],
      "outputs": ["dist/**"]
    },
    "@dangerous-inclinations/ui#build": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**",
        "public/**",
        "*.html",
        "vite.config.ts",
        "tsconfig.json",
        "package.json"
      ],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "scripts/**", "tsconfig.json", "package.json", "vitest.config.ts"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^build"]
    },
    "sim": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "bench": {
      "dependsOn": ["^build"],
      "cache": false
    }
  }
}
